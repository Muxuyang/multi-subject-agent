# 多学科智能体协商辅导系统
# 环境配置文件

# 大模型API配置（使用通义千问）
LLM_API_KEY=your_api_key_here
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 智能体服务端口配置
ORCHESTRATOR_PORT=8000
AGENT_MATH_PORT=8001
AGENT_PHYSICS_PORT=8002
AGENT_CHEMISTRY_PORT=8003
AGENT_BIOLOGY_PORT=8004
AGENT_ENGLISH_PORT=8005
AGENT_CHINESE_PORT=8006

# 梧桐平台配置（后续填写）
WUTONG_PLATFORM_URL=https://wt.ioa.pub
WUTONG_API_KEY=

# 日志配置
LOG_LEVEL=INFO
